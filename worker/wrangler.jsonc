{
  "name": "influ-quest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "vars": {
    "EVENT_ID": "shared-event"
  },
  "routes": [
    {
      "pattern": "influ-quest.nukoevi.app",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PLAYERS",
      "id": "d994bfbb80aa4f13b590c433cb35edf9"
    },
    {
      "binding": "SESSIONS",
      "id": "1e681ca8ed93495c8de716b9667e3049"
    }
  ],
  "d1_databases": [
    {
      "binding": "BUDGET_DB",
      "database_name": "todo-tasks-db",
      "database_id": "aa1a89d4-1dbe-443d-bf75-ac93bfcca8bc"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "QuestAgent"
      },
      {
        "name": "CHAT_SESSIONS",
        "class_name": "BrowserChatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuestAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BrowserChatSession"]
    }
  ],
  "ratelimits": [
    {
      "name": "PLAYER_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": {
        "limit": 3,
        "period": 10
      }
    },
    {
      "name": "EVENT_RATE_LIMIT",
      "namespace_id": "2002",
      "simple": {
        "limit": 4000,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "2003",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "CHAT_IP_RATE_LIMIT",
      "namespace_id": "2004",
      "simple": {
        "limit": 40,
        "period": 60
      }
    },
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "2005",
      "simple": {
        "limit": 1,
        "period": 60
      }
    },
    {
      "name": "DO_REQUEST_RATE_LIMITER",
      "namespace_id": "2006",
      "simple": {
        "limit": 1,
        "period": 60
      }
    }
  ]
}
